# Family Health Connect – Environment Variables Template

# Django core settings
SECRET_KEY=django-insecure-some-super-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*
FRONTEND_URL=http://localhost:5173

# Database configuration
# Leave empty to use SQLite (development)
# DATABASE_URL=postgres://user:password@localhost:5432/familyhealthconnect

# Redis / Channels Configuration (for WebSocket chat)
# Leave empty to use InMemoryChannelLayer
# REDIS_URL=redis://127.0.0.1:6379/0

# Integration keys
GEMINI_API_KEY=
SENTRY_DSN=
STRIPE_SECRET_KEY=

# CORS configurations
CORS_ALLOW_ALL=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
