<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Standard permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ── Health Connect READ permissions ─────────────────────────────────── -->
    <!-- These must be declared here AND in the <queries> block below.          -->
    <!-- Required by Health Connect on Android 14+.                             -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_OXYGEN" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <!-- Extended types used by the full health snapshot -->
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_BODY_MASS_INDEX" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" />
    <uses-permission android:name="android.permission.health.READ_HYDRATION" />

    <application
        android:label="family_health_mobile"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Visible theme while Flutter initialises -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- ── Health Connect: show permission rationale inside the app ──────── -->
        <!-- Health Connect calls this when the user taps "See all permissions"  -->
        <!-- in the Health Connect app and your app is listed.                   -->
        <activity-alias
            android:name=".HealthConnectRationaleActivity"
            android:targetActivity=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.platform.client.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity-alias>

        <!-- Flutter embedding metadata -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- ── Package visibility for Health Connect ─────────────────────────────
         Required so the app can detect whether Health Connect is installed
         and launch the Health Connect permission dialog.                        -->
    <queries>
        <!-- Process-text support (required by Flutter engine) -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Health Connect app package -->
        <package android:name="com.google.android.apps.healthdata" />

        <!-- Health Connect permission rationale intent -->
        <intent>
            <action android:name="androidx.health.platform.client.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>

        <!-- Health Connect request permissions intent (needed for the SDK) -->
        <intent>
            <action android:name="androidx.health.platform.client.ACTION_REQUEST_PERMISSIONS" />
        </intent>
    </queries>

</manifest>
